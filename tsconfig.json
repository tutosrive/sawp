{
    "compilerOptions": {
        "rootDir": "./app",
        "outDir": "./dist",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "target": "ESNext",
        "lib": ["ESNext", "DOM"],
        "types": ["node"],
        "sourceMap": true,
        "declaration": true,
        "declarationMap": true,
        "strict": false,
        "noImplicitAny": false,
        "strictNullChecks": false,
        "jsx": "react-jsx",
        "isolatedModules": true,
        "skipLibCheck": true
    }
}
